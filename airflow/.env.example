# Copy to `.env` (same folder) before `docker compose up`.
#
#   cp airflow/.env.example airflow/.env
#
# Only machine-specific paths live here — no secrets. `.env` is git-ignored;
# this `.env.example` is the committed template.

# Directory holding the BigQuery service account key. It is mounted read-only into
# the container at /opt/airflow/gcp, and the profile expects the file to be named
# dbt-service-account-key.json.
GCP_KEY_DIR=C:/Users/cordu/.gcp
